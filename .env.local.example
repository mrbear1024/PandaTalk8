# Supabase — copy to .env.local and fill in.
# If these are not set, the site renders from local seed data (lib/seed.ts).
NEXT_PUBLIC_SUPABASE_URL=

# New projects use sb_publishable_*. Legacy projects use the anon JWT —
# either env var name is accepted; the publishable key wins if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for /admin/* writes (bypasses RLS).
# New projects use sb_secret_*. Legacy projects use the service_role JWT —
# either name works.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin login password (single user). Rotating it logs out existing sessions.
ADMIN_PASSWORD=

# Cloudflare R2 — required for cover uploads (admin UI + scripts/blog.mjs).
# Without these, cover upload returns an error but posts can still be saved
# without a cover.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# DeepSeek — enables AI auto-fill of slug + tag on post create. OpenAI-
# compatible API. Falls back to slugify(title) + tag="note" if missing.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
